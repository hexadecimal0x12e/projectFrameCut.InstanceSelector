<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="projectFrameCut.InstanceSelector.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:projectFrameCut.InstanceSelector"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style
                x:Key="OpenWithListViewItemStyle"
                BasedOn="{StaticResource DefaultListViewItemStyle}"
                TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style
                x:Key="OpenWithButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="180" />
                <Setter Property="Padding" Value="24,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="16" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Padding="12,0,0,0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Image
                    Width="16"
                    Height="16"
                    Source="ms-appx:///Assets/Square44x44Logo.targetsize-24.png" />
                <TextBlock
                    x:Name="AppTitleTextBlock"
                    VerticalAlignment="Center"
                    FontSize="14"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="36,28,36,24"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="TitleTextBlock"
                x:Uid="TitleTextBlock"
                FontSize="28"
                FontWeight="Normal"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="StatusTextBlock"
                Grid.Row="1"
                Margin="0,12,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <TextBlock
                x:Name="ProjectPathTextBlock"
                Grid.Row="2"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <TextBlock
                x:Name="InstancesHeaderTextBlock"
                x:Uid="InstancesHeaderTextBlock"
                Grid.Row="3"
                Margin="0,14,0,4"
                FontSize="16"
                FontWeight="SemiBold" />

            <Grid Grid.Row="4">
                <ListView
                    x:Name="InstancesList"
                    MinHeight="180"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource OpenWithListViewItemStyle}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="InstancesList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ProjectFrameCutInstance">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    FontSize="16"
                                    Text="{x:Bind DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Row="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Details}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="NoInstancesTextBlock"
                    x:Uid="NoInstancesTextBlock"
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>

            <ScrollViewer
                x:Name="SettingsActionsPanel"
                Grid.Row="3"
                Grid.RowSpan="2"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Uid="DefaultCliInstanceTitle"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Uid="DefaultCliInstanceDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="DefaultCliInstanceComboBox"
                                x:Uid="DefaultCliInstanceComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="DefaultCliInstanceComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ProjectFrameCutInstance">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Details}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                x:Name="DefaultCliInstanceStateTextBlock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="SaveDefaultCliInstanceButton"
                                    x:Uid="SaveDefaultCliInstanceButton"
                                    HorizontalAlignment="Stretch"
                                    Click="SaveDefaultCliInstanceButton_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource OpenWithButtonStyle}" />
                                <Button
                                    x:Name="ClearDefaultCliInstanceButton"
                                    x:Uid="ClearDefaultCliInstanceButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Click="ClearDefaultCliInstanceButton_Click"
                                    Style="{StaticResource OpenWithButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Uid="DiagnosticCaptureTitle"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Uid="DiagnosticCaptureDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="DiagnosticInstanceComboBox"
                                x:Uid="DiagnosticInstanceComboBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="DiagnosticInstanceComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ProjectFrameCutInstance">
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind DisplayName}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Details}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock
                                x:Name="DiagnosticCaptureStateTextBlock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="StartDiagnosticCaptureButton"
                                x:Uid="StartDiagnosticCaptureButton"
                                HorizontalAlignment="Stretch"
                                Click="StartDiagnosticCaptureButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource OpenWithButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Uid="DirectoryClassTitle"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Uid="DirectoryClassDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DirectoryClassStateTextBlock"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    x:Name="InstallDirectoryClassButton"
                                    x:Uid="InstallDirectoryClassButton"
                                    HorizontalAlignment="Stretch"
                                    Click="InstallDirectoryClassButton_Click"
                                    Style="{StaticResource OpenWithButtonStyle}" />
                                <Button
                                    x:Name="UninstallDirectoryClassButton"
                                    x:Uid="UninstallDirectoryClassButton"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Click="UninstallDirectoryClassButton_Click"
                                    Style="{StaticResource OpenWithButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock
                                x:Uid="InstanceManagerTitle"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Uid="InstanceManagerDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="UninstallInstanceManagerButton"
                                x:Uid="UninstallInstanceManagerButton"
                                HorizontalAlignment="Stretch"
                                Click="UninstallInstanceManagerButton_Click"
                                Style="{StaticResource OpenWithButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="36,20"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="CloseButton"
                    x:Uid="CloseButton"
                    HorizontalAlignment="Stretch"
                    Click="CloseButton_Click"
                    Style="{StaticResource OpenWithButtonStyle}" />
                <Button
                    x:Name="OpenButton"
                    x:Uid="OpenButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OpenButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource OpenWithButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
